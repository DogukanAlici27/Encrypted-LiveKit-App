<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Video Alanı -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/remoteVideosRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />


        <!-- Arama Kontrolleri -->
        <HorizontalScrollView
            android:id="@+id/call_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="60dp"
            android:background="@drawable/bg_call_controls"
            android:elevation="20dp"
            android:visibility="gone"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/speakerButton"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/accent_blue_alpha"
                    app:icon="@drawable/ic_speaker_on"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="28dp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/muteButton"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/accent_blue_alpha"
                    app:icon="@drawable/ic_mic_on"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="28dp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switchCameraButton"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/accent_blue_alpha"
                    app:icon="@drawable/ic_camera_switch"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="28dp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/leaveButton"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/danger_red"
                    app:icon="@drawable/ic_hangup"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="28dp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addParticipantButton"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/accent_blue_alpha"
                    app:icon="@drawable/ic_people"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="28dp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cameraToggleButton"
                    style="@style/Widget.MaterialComponents.Button.Icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/accent_blue_alpha"
                    app:icon="@drawable/ic_videocam_on"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/ui_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <RelativeLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingBottom="16dp"
                android:background="@color/bg_card"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVEKIT"
                        android:textColor="@color/accent_blue"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@color/accent_blue"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewGroupHeader"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="8dp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_people"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/accent_blue"
                        app:rippleColor="@color/accent_blue_alpha" />

                    <ImageView
                        android:id="@+id/syncStatusIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_home"
                        android:visibility="gone"
                        app:tint="@color/text_gray" />

                    <TextView
                        android:id="@+id/connectionStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="@color/success_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="ÇEVRİMİÇİ"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

            </RelativeLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <!-- Giriş Paneli -->
                <LinearLayout
                    android:id="@+id/home_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Kullanıcı Adı"
                        app:hintTextColor="@color/accent_blue"
                        app:boxStrokeColor="@color/accent_blue"
                        app:boxBackgroundColor="@color/bg_input"
                        android:textColorHint="@color/text_gray"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/identityEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Şifre"
                        app:hintTextColor="@color/accent_blue"
                        app:boxStrokeColor="@color/accent_blue"
                        app:boxBackgroundColor="@color/bg_input"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/text_gray"
                        android:textColorHint="@color/text_gray"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_white"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="32dp"
                        android:text="GİRİŞ YAP"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent_blue"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/registerButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="YENİ HESAP"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textColor="@color/text_gray" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/rememberMeCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Beni Hatırla"
                        android:textColor="@color/text_gray"
                        app:buttonTint="@color/accent_blue"
                        android:checked="true" />
                </LinearLayout>

                <!-- Rehber Paneli -->
                <LinearLayout
                    android:id="@+id/contacts_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KULLANICILAR"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/contactsCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="0 Kullanıcı"
                            android:textColor="@color/accent_blue"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="@color/bg_input"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeWidth="0dp"
                        app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:startIconTint="@color/text_gray"
                        app:hintTextColor="@color/text_gray"
                        android:textColorHint="@color/text_gray">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/contactSearchEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Rehberde ara..."
                            android:textColor="@color/text_white"
                            android:singleLine="true"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/contactsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <!-- Mesajlar Paneli -->
                <LinearLayout
                    android:id="@+id/messages_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="MESAJLAR"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/messagesRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <!-- Geçmiş Paneli -->
                <LinearLayout
                    android:id="@+id/history_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="ARAMA GEÇMİŞİ"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clearHistoryBtn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="TEMİZLE"
                            android:textColor="@color/danger_red"
                            android:textSize="10sp"
                            android:padding="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            app:rippleColor="@color/danger_red" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/historyRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>

                <!-- Ayarlar Paneli (eski adıyla Profil) -->
                <LinearLayout
                    android:id="@+id/profile_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AYARLAR"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp" />

                    <!-- ============ ANA AYARLAR LİSTESİ ============ -->
                    <LinearLayout
                        android:id="@+id/settingsMenuPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:padding="8dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <androidx.cardview.widget.CardView
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                app:cardCornerRadius="50dp"
                                app:cardBackgroundColor="@color/bg_card"
                                app:cardElevation="4dp">
                                <ImageView
                                    android:id="@+id/currentProfilePhotoImg"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_person"
                                    android:padding="25dp"
                                    app:tint="@color/accent_blue"
                                    android:scaleType="centerCrop"
                                    android:clickable="false"
                                    android:focusable="false" />
                            </androidx.cardview.widget.CardView>

                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/editProfilePhotoFab"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="bottom|end"
                                android:src="@android:drawable/ic_menu_edit"
                                app:fabCustomSize="32dp"
                                app:maxImageSize="18dp"
                                app:backgroundTint="@color/accent_blue"
                                app:tint="@color/white"
                                app:elevation="12dp"
                                android:translationZ="10dp" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/currentUserTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#12FFFFFF"
                            android:layout_marginVertical="24dp" />

                        <!-- Hesap satırı -->
                        <LinearLayout
                            android:id="@+id/settingsAccountRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_person"
                                app:tint="@color/accent_blue" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="Hesap"
                                android:textColor="@color/text_white"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="@color/text_gray"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#12FFFFFF" />

                        <!-- Tema satırı -->
                        <LinearLayout
                            android:id="@+id/settingsThemeRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_menu_preferences"
                                app:tint="@color/accent_blue" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="Tema"
                                android:textColor="@color/text_white"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="@color/text_gray"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#12FFFFFF" />

                        <!-- Engellenenler satırı -->
                        <LinearLayout
                            android:id="@+id/settingsBlockedRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@android:drawable/ic_delete"
                                app:tint="@color/danger_red" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="Engellenen Kişiler"
                                android:textColor="@color/text_white"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="@color/text_gray"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ============ HESAP ALT PANELİ ============ -->
                    <LinearLayout
                        android:id="@+id/accountSettingsPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/accountBackRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="‹"
                                android:textColor="@color/accent_blue"
                                android:textSize="20sp"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hesap"
                                android:textColor="@color/text_white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/accountUsernameTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="24dp"
                            android:text="Kullanıcı adı: -"
                            android:textColor="@color/text_gray"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/logoutButton"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:text="OTURUMU KAPAT"
                            android:textColor="@color/danger_red" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/changePasswordButton"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:text="ŞİFRE DEĞİŞTİR"
                            android:textColor="@color/accent_blue" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/deleteAccountButton"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:text="HESABI SİL"
                            android:textColor="@color/danger_red"
                            android:alpha="0.6" />
                    </LinearLayout>

                    <!-- ============ TEMA ALT PANELİ ============ -->
                    <LinearLayout
                        android:id="@+id/themeSettingsPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/themeBackRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="‹"
                                android:textColor="@color/accent_blue"
                                android:textSize="20sp"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tema"
                                android:textColor="@color/text_white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Koyu tema seçeneği -->
                        <LinearLayout
                            android:id="@+id/themeDarkOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Koyu Tema (şu anki)"
                                android:textColor="@color/text_white"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/themeDarkCheck"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/checkbox_on_background"
                                app:tint="@color/accent_blue" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#12FFFFFF" />

                        <!-- Açık tema seçeneği -->
                        <LinearLayout
                            android:id="@+id/themeLightOption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Açık Tema"
                                android:textColor="@color/text_white"
                                android:textSize="16sp" />

                            <ImageView
                                android:id="@+id/themeLightCheck"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/checkbox_off_background"
                                app:tint="@color/accent_blue" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ============ ENGELLENENLER ALT PANELİ ============ -->
                    <LinearLayout
                        android:id="@+id/blockedSettingsPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/blockedBackRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="‹"
                                android:textColor="@color/accent_blue"
                                android:textSize="20sp"
                                android:layout_marginEnd="12dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Engellenen Kişiler"
                                android:textColor="@color/text_white"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/blockedRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/groupCallFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="150dp"
            android:text="GRUP ARA"
            android:textColor="@color/white"
            app:icon="@drawable/ic_people"
            app:iconTint="@color/white"
            app:backgroundTint="@color/accent_blue"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="100dp"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:elevation="25dp"
            android:alpha="0"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/bg_card"
        app:itemIconTint="@color/accent_blue"
        app:itemTextColor="@color/accent_blue"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Kendi kameramız artık RecyclerView içinde olduğu için bu kartı gizli tutuyoruz veya silebiliriz -->
    <androidx.cardview.widget.CardView
        android:id="@+id/localVideoCard"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardElevation="30dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <io.livekit.android.renderer.SurfaceViewRenderer
            android:id="@+id/localVideoRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>