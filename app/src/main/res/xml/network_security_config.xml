<?xml version="1.0" encoding="utf-8"?>
<!--
  NOT: <domain> etiketi CIDR aralığı (192.168.0.0/16 gibi) DESTEKLEMEZ; her IP tek tek
  yazılmalıdır. Token sunucusunu farklı bir makinede çalıştırıyorsan o makinenin IP'sini
  buraya ve NetworkClient.PHYSICAL_HOST_IP'ye eklemeyi unutma.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.120</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
